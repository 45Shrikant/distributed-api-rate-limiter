# Application Server Configuration
PORT=5000
NODE_ENV=production
SERVER_INSTANCE_ID=server-1

# Distributed Cache & Database Endpoints
MONGO_URI=mongodb://mongodb:27017/rate_limiter
REDIS_URL=redis://redis:6379

# Cryptographic Authentication Secrets
JWT_SECRET=super_secret_jwt_key_system_design_12345
JWT_EXPIRES_IN=7d

# Redis Outage Failure Strategy:
# 'closed' -> Reject requests when Redis is down (strict upstream protection)
# 'open'   -> Allow requests when Redis is down with warning logs (graceful degradation)
RATE_LIMIT_FAIL_MODE=closed
